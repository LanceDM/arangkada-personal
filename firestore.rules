rules_version = '2';

// Firestore security rules for Arangkada.
//
// Schema - the TypeScript types named are the authoritative shapes:
//   users/{uid}                                    UserProfile (features/auth)
//   users/{uid}/progress/summary                   UserProgressSummary
//   users/{uid}/attempts/{id}                      LevelAttempt, append-only
//   users/{uid}/attempts/{id}/telemetry/fsm        FsmTelemetryDoc
//   users/{uid}/attempts/{id}/telemetry/decisions  DecisionTelemetryDoc
//   users/{uid}/attempts/{id}/telemetry/routing    RoutingTelemetryDoc
//   users/{uid}/routing/assignment                 the pilot group the developers assigned
//   users/{uid}/routing/cursor                     StoredRoutingCursor
//   users/{uid}/routing/competencyCourse           CourseCursor (per-competency routing FSM)
//   users/{uid}/courseLog/{id}                     CourseLogEntry: decisions, rewards, table snapshot
//   users/{uid}/assessmentSittings/{id}            AssessmentSitting: quiz, diagnostic, post-exam answers
//   users/{uid}/study/background                   BackgroundResponse: the background form (muted by default)
//   users/{uid}/events/{eventId}                   StudyEvent: the participant's event stream, append-only
//   users/{uid}/state/events                       { nextSeq }: the event stream's counter
//   users/{uid}/bkt/profile                        BKTProfileDoc: the participant's own BKT now
//   users/{uid}/bktUpdates/{updateId}              BKTUpdateRecord: one per graded answer, append-only
//   users/{uid}/surveys/{instrument}               SurveyResponse: ISO/IEC 25010 or TAM, written once
//   policy/competencyQ                             the shared Q-table, learned online by every participant
//   policy/competencyQ/updates/{updateId}          QLogEntry: every table change, append-only
//   policy/config                                  the settings version in force (written by db:init)
//   configVersions/{tag}                           every settings version (written by db:init)
//   participants/{code}                            study enrolment (written by db:participant)
//   roleGrants/{id}                                admin grants and revokes (written by db:role)
//   meta/schema                                    which schema version the database was set up with
//
// Implementation B (VITE_DATABASE_MODE=firestore+sql) keeps participants,
// role grants, settings versions and form answers in SQL Connect instead
// (dataconnect/); the paths above for them are then unused. See DATABASE.md.
//   users/{uid}/examAttempts/{id}                  ExamAttempt, append-only
//   users/{uid}/dailyStreak/summary                DailyStreakSummary
//   users/{uid}/dailyAttempts/{id}                 DailyAttempt, append-only
//   exam_questions/{id}                            RemoteExamQuestion, shared content
//
// Who:
//   - A player reads and writes only their own users/{uid} tree, and can delete
//     nothing in it. Records are append-only. Their pilot group
//     (routing/assignment) they read and never write: the developers assign it
//     with the service account.
//   - An admin is the custom claim `admin: true` on the sign-in token, set by
//     the developers with the service account. It is never a document field:
//     a `role` on a profile is a legacy label that no rule and no screen
//     trusts, and no player write can change it.
//   - An admin reads every player's data (the report's collection-group
//     queries included) and writes only the exam question bank.
//
// What these rules cannot do: check that a number is true. Every score, streak
// and attempt is computed in the browser, so the rules decide who may write
// and the shape written, never whether a score was earned.
//
// Shape checks name the keys a record must carry and their types. Only the
// profile also refuses keys it does not know, because its fields are the ones
// the admin report lists for every player. Everything else accepts an added
// key, so an additive payload change - how these shapes have always evolved -
// never makes a save fail and lose the record.
//
// The developers test these rules on the Firestore emulator before a change
// to a path or a payload ships.
//
// Legacy collections (fsm_sessions, exam_results, daily_results, and the
// `progress`/`daily` fields still embedded in old users/{uid} docs) are
// intentionally NOT deleted or migrated - they are frozen historical data.
// Nothing in the app writes to them anymore; rules below make that
// permanent (read-only) rather than leaving it as an unenforced convention.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.get('admin', false) == true;
    }

    function isCount(value) {
      return value is number && value >= 0;
    }

    // ── Shapes ─────────────────────────────────────────────

    function profileKeys() {
      return ['email', 'username', 'role', 'createdAt', 'totalScore', 'longestStreak', 'bestExamScore'];
    }

    // Checks only the keys a write sets, so a field an old profile already
    // carries is left as it is rather than re-judged on every merge.
    function profileFieldsValid(data, keys) {
      return (!keys.hasAny(['email']) || data.email is string)
        && (!keys.hasAny(['username']) || data.username is string)
        && (!keys.hasAny(['createdAt']) || data.createdAt is number)
        && (!keys.hasAny(['totalScore']) || isCount(data.totalScore))
        && (!keys.hasAny(['longestStreak']) || isCount(data.longestStreak))
        && (!keys.hasAny(['bestExamScore']) || isCount(data.bestExamScore));
    }

    function isProgressSummary(data) {
      return data.keys().hasAll(['unlockedLevels', 'levelBest', 'updatedAt'])
        && data.unlockedLevels is list
        && data.levelBest is map
        && data.updatedAt is number;
    }

    function isLevelAttempt(data) {
      return data.keys().hasAll(['levelId', 'timestamp', 'finalScore', 'violations', 'correctDecisions', 'logs'])
        && data.levelId is int && data.levelId >= 0
        && data.timestamp is number
        && data.finalScore is number
        && isCount(data.violations)
        && isCount(data.correctDecisions)
        && data.logs is list
        && (!data.keys().hasAny(['fsmMetrics']) || data.fsmMetrics is map)
        && (!data.keys().hasAny(['reactionLatencies']) || data.reactionLatencies is list);
    }

    function isFsmTelemetry(data) {
      return data.keys().hasAll(['transitions', 'truncated', 'totalCount'])
        && data.transitions is list
        && data.truncated is bool
        && isCount(data.totalCount);
    }

    function isDecisionTelemetry(data) {
      return data.keys().hasAll([
          'schemaVersion', 'levelId', 'attemptSeed', 'route', 'bkt', 'policy',
          'rerolls', 'decisions', 'truncated', 'totalCount'
        ])
        && data.schemaVersion == 1
        && data.levelId is int
        && data.attemptSeed is number
        && data.route is list
        && data.bkt is map
        && data.policy is map
        && data.rerolls is list
        && data.decisions is list
        && data.truncated is bool
        && isCount(data.totalCount);
    }

    function isRoutingTelemetry(data) {
      return data.keys().hasAll([
          'schemaVersion', 'mode', 'assignedGroup', 'groupInEffect', 'override',
          'options', 'driving', 'entry', 'log', 'truncated', 'totalCount'
        ])
        && data.schemaVersion == 1
        && data.mode in ['legacy', 'new']
        && (data.assignedGroup == null || data.assignedGroup in ['conventional', 'optimized'])
        && data.groupInEffect in ['legacy', 'conventional', 'optimized']
        && data.override is bool
        && data.options is map
        && data.driving is map
        && (data.entry == null || data.entry is map)
        && data.log is list
        && data.truncated is bool
        && isCount(data.totalCount);
    }

    // A cursor is never inside a review: a review's `return` is taken by the
    // attempt that played it.
    function isRoutingCursor(data) {
      return data.keys().hasAll(['schemaVersion', 'state', 'outcome', 'seq', 'decisionsSpent', 'pending', 'updatedAt'])
        && data.schemaVersion == 1
        && data.state is map
        && data.state.kind in ['DRIVE', 'FINAL', 'CERTIFIED']
        && (data.outcome == null || data.outcome in ['passed', 'failed'])
        && isCount(data.seq)
        && isCount(data.decisionsSpent)
        && (data.pending == null || data.pending is map)
        && data.updatedAt is number;
    }

    function isCourseCursor(data) {
      return data.keys().hasAll(['schemaVersion', 'phase', 'stage', 'pending', 'seen', 'flagged', 'seq', 'updatedAt'])
        && data.schemaVersion == 1
        && data.phase is map
        && data.phase.kind in ['MODULE', 'QUIZ', 'QUIZ_REVIEW', 'DRIVE', 'REPEAT', 'FINAL', 'CERTIFIED']
        && data.stage is map
        && data.pending is list
        && data.seen is map
        && data.flagged is list
        && isCount(data.seq)
        && data.updatedAt is number;
    }

    function isCourseLogEntry(data) {
      return data.keys().hasAll(['schemaVersion', 'kind', 'levelId', 'decisions', 'rewards', 'timestamp'])
        && data.schemaVersion == 1
        && data.kind in ['drive', 'quiz', 'post_exam', 'final']
        && data.decisions is list
        && data.rewards is list
        && data.timestamp is number;
    }

    function isBackgroundResponse(data) {
      return data.keys().hasOnly(['schemaVersion', 'formVersion', 'answers', 'timestamp'])
        && data.schemaVersion == 1
        && data.formVersion is int
        && data.answers is map
        && data.answers.size() <= 20
        && data.timestamp is number;
    }

    function isAssessmentSitting(data) {
      return data.keys().hasAll(['schemaVersion', 'kind', 'answers', 'timestamp'])
        && data.schemaVersion == 1
        && data.kind in ['quiz', 'diagnostic', 'post_exam']
        && data.answers is list
        && data.timestamp is number;
    }

    // The shared table holds 8 states; every update is the whole table,
    // written in a transaction on the newest version.
    // A logged record's own id is its eventId, made on the device; it never
    // changes once written. A retried write may only touch the server time.
    function isEnvelope(data, uid, id) {
      return data.keys().hasAll(['schemaVersion', 'eventId', 'uid', 'at', 'sessionId', 'appBuild', 'configVersion'])
        && data.schemaVersion == 1
        && data.eventId == id
        && data.uid == uid
        && data.at is number
        && data.sessionId is string
        && data.appBuild is string
        && data.configVersion is string;
    }

    function onlyServerTimeChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['serverAt']);
    }

    function isStudyEvent(data, uid, id) {
      return isEnvelope(data, uid, id)
        && data.keys().hasAll(['type', 'seq', 'payload'])
        && data.type in [
          'session_started', 'page_viewed', 'course_transition', 'sitting_submitted', 'item_answered',
          'background_submitted', 'survey_submitted', 'drive_planned', 'decision_made', 'drive_ended',
          'verdict_computed', 'policy_decision', 'reward_computed', 'app_error'
        ]
        && (data.seq == null || data.seq is int)
        && data.payload is map;
    }

    function isBKTUpdate(data, uid, id) {
      return isEnvelope(data, uid, id)
        && data.keys().hasAll(['userSeq', 'competency', 'source', 'correct', 'params', 'pBefore', 'predictedCorrect', 'posterior', 'pAfter'])
        && data.userSeq is int
        && data.source in ['drive', 'quiz', 'diagnostic', 'post_exam']
        && data.correct is bool
        && data.params is map
        && data.pBefore is number && data.pAfter is number;
    }

    function isBKTProfile(data, uid) {
      return data.keys().hasAll(['schemaVersion', 'uid', 'configVersion', 'updates', 'competencies', 'updatedAt'])
        && data.schemaVersion == 1
        && data.uid == uid
        && data.updates is int
        && data.competencies is map
        && data.competencies.size() == 11;
    }

    function isSurvey(data, instrument) {
      return data.keys().hasOnly(['schemaVersion', 'instrument', 'formVersion', 'answers', 'timestamp'])
        && data.schemaVersion == 1
        && data.instrument == instrument
        && instrument in ['iso25010', 'tam']
        && data.formVersion is int
        && data.answers is map
        && data.timestamp is number;
    }

    function isQLogEntry(data, id) {
      return isEnvelope(data, request.auth.uid, id)
        && data.keys().hasAll(['globalSeq', 'kind', 'stateKey', 'action', 'tableAfter', 'statesAfter'])
        && data.globalSeq is int
        && data.kind in ['visit', 'learn']
        && data.tableAfter is map;
    }

    function isLoggedTableChange(previousUpdates) {
      let next = request.resource.data;
      let entryPath = /databases/$(database)/documents/policy/competencyQ/updates/$(next.lastUpdate.updateId);
      return next.updates > previousUpdates
        && next.lastUpdate is map
        && next.lastUpdate.uid == request.auth.uid
        && next.lastUpdate.globalSeq == next.updates
        && existsAfter(entryPath)
        && getAfter(entryPath).data.globalSeq == next.updates
        && getAfter(entryPath).data.uid == request.auth.uid;
    }

    function isQTableDoc(data) {
      return data.keys().hasAll(['schemaVersion', 'table', 'updates', 'updatedAt'])
        && data.schemaVersion == 1
        && data.table is map
        && data.table.size() <= 8
        && isCount(data.updates)
        && data.updatedAt is number;
    }

    function isExamAttempt(data) {
      return data.keys().hasAll(['score', 'passed', 'wrongIds', 'questionIds', 'timestamp'])
        && isCount(data.score)
        && data.passed is bool
        && data.wrongIds is list
        && data.questionIds is list
        && data.timestamp is number;
    }

    function isDailyStreak(data) {
      return data.keys().hasAll(['currentStreak', 'longestStreak', 'lastCompletedDate', 'completedDates', 'updatedAt'])
        && isCount(data.currentStreak)
        && isCount(data.longestStreak)
        && (data.lastCompletedDate == null || data.lastCompletedDate is string)
        && data.completedDates is list
        && data.updatedAt is number;
    }

    function isDailyAttempt(data) {
      return data.keys().hasAll(['date', 'scenarioId', 'selectedIndex', 'correct', 'timestamp'])
        && data.date is string
        && data.scenarioId is string
        && data.selectedIndex is int && data.selectedIndex >= 0
        && data.correct is bool
        && data.timestamp is number;
    }

    // ── users/{uid} ────────────────────────────────────────
    match /users/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      // Only the admin report lists accounts: a profile carries an email.
      allow list: if isAdmin();

      // Created at sign-up - or first, as `{ totalScore }` alone, when
      // ProgressSync's merge lands before sign-up's own write, which then
      // arrives as an update. `role` may only ever read 'player'.
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(profileKeys())
        && profileFieldsValid(request.resource.data, request.resource.data.keys())
        && request.resource.data.get('role', 'player') == 'player';

      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(profileKeys())
        && profileFieldsValid(request.resource.data, request.resource.data.diff(resource.data).affectedKeys())
        && request.resource.data.get('role', 'player') == resource.data.get('role', 'player');

      allow delete: if false;

      match /progress/summary {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update: if isOwner(uid) && isProgressSummary(request.resource.data);
        allow delete: if false;
      }

      match /attempts/{attemptId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid) && isLevelAttempt(request.resource.data);
        allow update, delete: if false; // append-only, never rewrite history

        // The raw FSM transition log, the per-decision record and the routing
        // record, apart from the attempt because they are large or read only
        // by analysis. Each is written once, after the attempt it belongs to
        // exists.
        match /telemetry/{docId} {
          allow read: if isOwner(uid) || isAdmin();
          allow create: if isOwner(uid)
            && exists(/databases/$(database)/documents/users/$(uid)/attempts/$(attemptId))
            && ((docId == 'fsm' && isFsmTelemetry(request.resource.data))
              || (docId == 'decisions' && isDecisionTelemetry(request.resource.data))
              || (docId == 'routing' && isRoutingTelemetry(request.resource.data)));
          allow update, delete: if false;
        }
      }

      // The routing FSM in the game. The assignment is written by the
      // developers alone, with the service account, which these rules do not
      // govern: no
      // client writes it, so no player can choose their own group, and an
      // admin writes no player data. The cursor is the player's place in the
      // course, rewritten as they play.
      match /routing/{docId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update: if isOwner(uid)
          && ((docId == 'cursor' && isRoutingCursor(request.resource.data))
            || (docId == 'competencyCourse' && isCourseCursor(request.resource.data)));
        allow delete: if false;
      }

      // Every policy decision and reward of the per-competency routing FSM, append-only.
      match /courseLog/{entryId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid) && isCourseLogEntry(request.resource.data);
        allow update, delete: if false;
      }

      // The background form, written once and never changed.
      match /study/{docId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid) && docId == 'background' && isBackgroundResponse(request.resource.data);
        allow update, delete: if false;
      }

      // The event stream: append-only; its counter only moves forward.
      match /events/{eventId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid) && isStudyEvent(request.resource.data, uid, eventId);
        allow update: if isOwner(uid) && onlyServerTimeChanged();
        allow delete: if false;
      }

      match /state/{docId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid) && docId == 'events'
          && request.resource.data.nextSeq is int && request.resource.data.nextSeq >= 1;
        allow update: if isOwner(uid) && docId == 'events'
          && request.resource.data.nextSeq is int && request.resource.data.nextSeq > resource.data.nextSeq;
        allow delete: if false;
      }

      // The participant's own BKT: the profile now, and one log entry per answer.
      match /bkt/{docId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update: if isOwner(uid) && docId == 'profile' && isBKTProfile(request.resource.data, uid);
        allow delete: if false;
      }

      match /bktUpdates/{updateId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid) && isBKTUpdate(request.resource.data, uid, updateId);
        allow update: if isOwner(uid) && onlyServerTimeChanged();
        allow delete: if false;
      }

      match /surveys/{instrument} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid) && isSurvey(request.resource.data, instrument);
        allow update, delete: if false;
      }

      // Quiz, diagnostic and post-exam answers, append-only; BKT reads all of them.
      match /assessmentSittings/{sittingId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid) && isAssessmentSitting(request.resource.data);
        allow update, delete: if false;
      }

      match /examAttempts/{attemptId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid) && isExamAttempt(request.resource.data);
        allow update, delete: if false;
      }

      match /dailyStreak/summary {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update: if isOwner(uid) && isDailyStreak(request.resource.data);
        allow delete: if false;
      }

      match /dailyAttempts/{attemptId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid) && isDailyAttempt(request.resource.data);
        allow update, delete: if false;
      }
    }

    // ── The admin report's collection-group queries ────────
    // A collection-group query is judged against a recursive match only, never
    // against the per-user rules above.
    match /{path=**}/attempts/{attemptId} {
      allow read: if isAdmin();
    }

    match /{path=**}/examAttempts/{attemptId} {
      allow read: if isAdmin();
    }

    match /{path=**}/dailyAttempts/{attemptId} {
      allow read: if isAdmin();
    }

    match /{path=**}/courseLog/{entryId} {
      allow read: if isAdmin();
    }

    match /{path=**}/assessmentSittings/{sittingId} {
      allow read: if isAdmin();
    }

    match /{path=**}/study/{docId} {
      allow read: if isAdmin();
    }

    match /{path=**}/events/{eventId} {
      allow read: if isAdmin();
    }

    match /{path=**}/bktUpdates/{updateId} {
      allow read: if isAdmin();
    }

    match /{path=**}/surveys/{instrument} {
      allow read: if isAdmin();
    }

    // ── The shared Q-table ─────────────────────────────────
    // Learned online from the participants themselves: any signed-in player's
    // drive updates it, in a transaction. The rules check its shape only; a
    // value cannot be checked here, as with every score.
    match /policy/competencyQ {
      allow read: if isSignedIn();
      // A participant's change must come with its log: the counter only moves
      // forward, the last change names this participant, and the log entry it
      // names exists in the same transaction under the new counter. Every
      // change to the table is therefore attributed and on the record. (The
      // values themselves cannot be checked here; see DATABASE.md.)
      allow create: if isSignedIn() && isQTableDoc(request.resource.data) && isLoggedTableChange(0);
      allow update: if isSignedIn() && isQTableDoc(request.resource.data) && isLoggedTableChange(resource.data.updates);
      allow delete: if false;

      // Every change to the table, written in the same transaction by the
      // participant whose decision or reward caused it.
      match /updates/{updateId} {
        allow read: if isAdmin();
        // Written only together with the table: the table after the
        // transaction must already count this entry.
        allow create: if isSignedIn() && isQLogEntry(request.resource.data, updateId)
          && getAfter(/databases/$(database)/documents/policy/competencyQ).data.updates >= request.resource.data.globalSeq;
        allow update: if isSignedIn() && resource.data.uid == request.auth.uid && onlyServerTimeChanged();
        allow delete: if false;
      }
    }

    // ── Settings, enrolment and roles ───────────────────────
    // Written only by the scripts in scripts/db with the service account,
    // which these rules do not govern. The app reads the settings in force.
    match /policy/config {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /configVersions/{tag} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /participants/{code} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /roleGrants/{grantId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /meta/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── Shared content ─────────────────────────────────────
    // Public: guests sit the mock exam too, and the bank also ships in the
    // bundle as the local fallback.
    match /exam_questions/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Legacy collections: frozen, read-only ──────────────
    // Nothing writes here anymore; formally closing writes prevents this
    // deploy from accidentally re-opening a path nothing should use.
    match /fsm_sessions/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    match /exam_results/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    match /daily_results/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }
  }
}
