{
  "name": "arangkada",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emulator": "vite --mode emulator",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "fsm:check": "tsx scripts/characterizeFsm.ts",
    "fsm:update-golden": "tsx scripts/characterizeFsm.ts --write",
    "routing:check": "tsx scripts/characterizeRoutingFsm.ts",
    "routing:update-golden": "tsx scripts/characterizeRoutingFsm.ts --write",
    "emulators": "firebase emulators:start --only auth,firestore",
    "db:init": "tsx scripts/db/init.ts",
    "db:validate": "tsx scripts/db/validate.ts",
    "db:audit": "tsx scripts/db/audit.ts",
    "db:role": "tsx scripts/db/role.ts",
    "db:participant": "tsx scripts/db/participant.ts",
    "db:deploy": "firebase deploy --only firestore:rules,firestore:indexes",
    "db:deploy:sql": "firebase deploy --config firebase.sql.json --only dataconnect",
    "emulators:sql": "firebase emulators:start --config firebase.sql.json --only dataconnect"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-query": "^5.99.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.12.1",
    "lucide-react": "^1.8.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^13.29.1",
    "globals": "^17.4.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vitest": "^4.1.10"
  }
}
