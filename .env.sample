# Copy to .env and fill in from Firebase console > Project settings > Your apps > Web app.
# With no API key the app runs against the local emulators (npm run emulators).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# true: use the emulators even with a key set.
VITE_USE_FIREBASE_EMULATOR=false

# new (the per-competency course) or legacy (the old game).
VITE_ROUTING_SWITCH=new

# Database implementation (DATABASE.md):
#   firestore      Implementation A, everything in Firestore (default)
#   firestore+sql  Implementation B, people/roles/settings/forms in SQL Connect (Blaze plan)
VITE_DATABASE_MODE=firestore

# Implementation B only; must match dataconnect/dataconnect.yaml and connector.yaml.
VITE_SQL_SERVICE=arangkada
VITE_SQL_CONNECTOR=arangkada
VITE_SQL_LOCATION=asia-southeast1
